; Godot 4 native 2D game. Import this file in Godot.
config_version=5

[application]
config/name="Çatpat: Festival Yolu"
config/version="0.15.0-production-alpha"
run/main_scene="res://scenes/polish_v3.tscn"

[autoload]
CatpatProfiles="*res://scripts/core/profile_service.gd"
CatpatObservations="*res://scripts/core/observation_service.gd"
CatpatAudio="*res://scripts/core/audio_service.gd"
CatpatExperience="*res://scripts/core/experience_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.06,0.19,0.18,1)

[physics]
common/physics_ticks_per_second=60
